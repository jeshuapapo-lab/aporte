mn:conditionExpression xsi:type="bpmn:tFormalExpression">solicitudCompleta = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F5" sourceRef="Preparar" targetRef="Responder" /><bpmn:sequenceFlow id="F6" sourceRef="Responder" targetRef="Fin" /><bpmn:sequenceFlow id="F7" sourceRef="Decision" targetRef="Pedir" name="No" /><bpmn:sequenceFlow id="F8" sourceRef="Pedir" targetRef="Recibir" /><bpmn:sequenceFlow id="F9" sourceRef="Recibir" targetRef="Verificar" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Estado_actual"><bpmndi:BPMNPlane id="Plane_Estado_actual" bpmnElement="Proceso_Estado_actual"><bpmndi:BPMNShape id="Shape_Inicio" bpmnElement="Inicio"><dc:Bounds x="125" y="410" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Registrar" bpmnElement="Registrar"><dc:Bounds x="220" y="386" width="165" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Verificar" bpmnElement="Verificar"><dc:Bounds x="435" y="386" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Decision" bpmnElement="Decision"><dc:Bounds x="670" y="401" width="56" height="56" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Preparar" bpmnElement="Preparar"><dc:Bounds x="805" y="386" width="182" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Responder" bpmnElement="Responder"><dc:Bounds x="1055" y="386" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Fin" bpmnElement="Fin"><dc:Bounds x="1335" y="410" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Pedir" bpmnElement="Pedir"><dc:Bounds x="805" y="600" width="182" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Recibir" bpmnElement="Recibir"><dc:Bounds x="1055" y="600" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Edge_F1" bpmnElement="F1"><di:waypoint x="161" y="428" /><di:waypoint x="220" y="428" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_F2" bpmnElement="F2"><di:waypoint x="385" 